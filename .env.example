# Gen DND - Environment Variables
# Copy to .env and fill in values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMODB_TABLE_PREFIX=GenDnd
# Uncomment for local development with DynamoDB Local:
# DYNAMODB_ENDPOINT=http://dynamodb-local:8000

# Bedrock Agent IDs (populated after agent creation)
BEDROCK_DM_AGENT_ID=
BEDROCK_DM_AGENT_ALIAS=
BEDROCK_LORE_AGENT_ID=
BEDROCK_LORE_AGENT_ALIAS=
BEDROCK_UPDATER_AGENT_ID=
BEDROCK_UPDATER_AGENT_ALIAS=

# Image Generation
BEDROCK_IMAGE_MODEL_ID=amazon.titan-image-generator-v1
SAGEMAKER_ENDPOINT_NAME=

# Backend
PORT=4000
NODE_ENV=development

# Domain (optional - for Route 53 setup)
DOMAIN_NAME=
HOSTED_ZONE_ID=
