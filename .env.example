# Gen DND - Environment Variables
# Copy to .env and fill in values. Never commit .env (it is gitignored).

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials
AWS_SESSION_TOKEN=

# DynamoDB
DYNAMODB_TABLE_PREFIX=GenDnd
# Uncomment for local development with DynamoDB Local:
# DYNAMODB_ENDPOINT=http://dynamodb-local:8000

# ---------------------------------------------------------------------------
# Bedrock text models
#
# All text generation goes through the Converse API (see agents/bedrockClient.ts),
# so any Converse-capable model works here regardless of provider.
#
# Pick these by latency budget, not just quality:
#  - LORE runs synchronously inside POST /api/game/create. If the app is fronted
#    by an API Gateway HTTP API, that request is killed at 30s, so lore needs a
#    fast model (a "long" campaign generates 30 events of JSON).
#  - DM / UPDATER run asynchronously in the game loop and are pushed to clients
#    over SSE (or the polling fallback), so they have no HTTP deadline and can
#    use a slower, higher-quality model.
#
# Check availability with:
#   aws bedrock list-foundation-models --region <region>
# Models restricted to INFERENCE_PROFILE need a region prefix, e.g. "us.".
# ---------------------------------------------------------------------------
BEDROCK_LORE_MODEL=amazon.nova-lite-v1:0
BEDROCK_DM_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_UPDATER_MODEL=us.anthropic.claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Bedrock image generation
#
# imageGenerator.ts picks the request payload from the model id prefix:
#   stability.* -> {prompt, mode, aspect_ratio, output_format}
#   amazon.*    -> {taskType, textToImageParams, imageGenerationConfig}
# If generation fails for any reason it falls back to an SVG placeholder and
# logs the real error (model + region + message).
#
# Image models are not offered in every region, so this region is set separately
# from AWS_REGION.
# ---------------------------------------------------------------------------
BEDROCK_IMAGE_MODEL=stability.sd3-5-large-v1:0
BEDROCK_IMAGE_MODEL_ID=stability.sd3-5-large-v1:0
BEDROCK_IMAGE_REGION=us-west-2

# S3 bucket for generated assets.
# S3_IMAGE_REGION must match the bucket's actual region or S3 rejects uploads
# with PermanentRedirect (301). A bucket in us-east-1 reports LocationConstraint
# null: aws s3api get-bucket-location --bucket <name>
S3_IMAGE_BUCKET=
S3_IMAGE_REGION=us-east-1
ASSETS_BUCKET=

# Polly TTS (optional — falls back to text-only if not configured)
POLLY_ENABLED=true
POLLY_VOICE_ID=Matthew
POLLY_ENGINE=neural

# Backend
PORT=4000
NODE_ENV=development

# Domain (optional - for Route 53 setup)
DOMAIN_NAME=
HOSTED_ZONE_ID=
